# The token file is a bearer credential: it must never be in an image layer.
# Neither should a certificate's private key, a probe, or a generated frame.
.git/
.gitignore
**/__pycache__/
**/*.py[cod]
**/state/
nlzietd/state/
qr_check/
stream_check/
probe_*.py
explore.py
*.pem
*.crt
*.key
*.pfx
*.log
*.ts
